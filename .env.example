# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed — see shared/helpers/env.php for the loader.

# Database connection (used by shared/config/database.php). Defaults match
# a standard local XAMPP install if left unset.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=enroll_db

# Timezone for PHP and the MySQL session (shared/config/database.php).
# Defaults to Asia/Manila if unset.
APP_TIMEZONE=Asia/Manila

# Gmail SMTP (used by shared/config/mail.php). Generate at:
# Google Account -> Security -> App passwords
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=

# PayMongo API keys (used by shared/config/paymongo.php). Dashboard ->
# Developers -> API Keys. Use sk_test_/pk_test_ locally, sk_live_/pk_live_
# only in the production .env.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# AI quiz generation (Quiz Builder -> "Generate from File"; see
# shared/helpers/ai_quiz.php). AI_PROVIDER is "gemini" (free tier available at
# https://aistudio.google.com/apikey) or "claude" (https://console.anthropic.com).
# AI_MODEL is optional (defaults: gemini-3.8-flash / claude-haiku-5-5).
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=
